#!/bin/sh /etc/rc.common
# procd service for xrayopd.
#
# Starts after the network is up (START=95) and stops early (STOP=10) so the
# proxy is torn down before interfaces go away.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/xrayopd
STATE_DIR=/etc/xrayop
RUNTIME_DIR=/var/etc/xrayop

start_service() {
	config_load xrayop

	local enabled listen
	config_get_bool enabled main enabled 1
	config_get listen main listen "0.0.0.0:8088"

	[ "$enabled" -eq 1 ] || return 0

	# State persists across reboots; runtime lives on tmpfs to spare the flash.
	mkdir -p "$STATE_DIR" "$RUNTIME_DIR"

	# State holds node UUIDs and REALITY keys; keep it off other users' eyes.
	chmod 0700 "$STATE_DIR" "$RUNTIME_DIR" 2>/dev/null

	procd_open_instance xrayop
	procd_set_param command "$PROG" \
		--listen "$listen" \
		--state "$STATE_DIR/state.json" \
		--runtime "$RUNTIME_DIR"

	# Retry count 0 means "never give up". The default (respawn 3600 5 5) makes
	# procd abandon the service after five fast crashes -- and if transparent
	# proxying was active at that moment, its nftables rules stay loaded with
	# nothing listening behind them and the whole LAN loses internet until a
	# human intervenes. homeproxy and nikki both ship that failure mode.
	procd_set_param respawn 3600 5 0

	# xray opens one socket per UDP 4-tuple under TPROXY and reclaims them only
	# on idle timeout. The kernel default of 1024 is reached quickly by a single
	# torrent client; this is the most common cause of "xray stopped working"
	# on routers running Passwall2, which sets no limit at all.
	procd_set_param limits nofile="65536 65536"

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/xrayopd.pid
	procd_close_instance
}

stop_service() {
	# nftables rules outlive the process that made them. Leaving them loaded
	# while the daemon is stopped points every LAN packet at a port with
	# nothing behind it -- the LAN loses the internet and stays that way until
	# something restarts the service.
	#
	# Taking them down here means a stopped service fails safe: traffic goes
	# direct. The daemon puts them back on start when the mode calls for it.
	nft delete table inet xrayop 2>/dev/null

	local fam
	for fam in -4 -6; do
		while ip $fam rule del fwmark 494 table 494 2>/dev/null; do :; done
	done
	ip -4 route del local 0.0.0.0/0 dev lo table 494 2>/dev/null
	ip -6 route del local ::/0 dev lo table 494 2>/dev/null

	# Hand DNS back, or the LAN keeps asking a resolver that is not answering.
	local dropped=0 f
	for f in /tmp/dnsmasq.*.d/zz-xrayop.conf /var/dnsmasq.*.d/zz-xrayop.conf; do
		[ -f "$f" ] && { rm -f "$f"; dropped=1; }
	done
	[ "$dropped" = 1 ] && /etc/init.d/dnsmasq restart >/dev/null 2>&1

	return 0
}

service_triggers() {
	procd_add_reload_trigger "xrayop"
}

reload_service() {
	restart
}
